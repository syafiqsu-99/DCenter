{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DCenter.Server (launch)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/DCenter.Server/bin/Debug/net10.0/DCenter.Server.dll",
      "cwd": "${workspaceFolder}/DCenter.Server",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7260;http://localhost:5031",
        "ASPNETCORE_HOSTINGSTARTUPASSEMBLIES": "Microsoft.AspNetCore.SpaProxy"
      }
    },
    {
      "name": "DCenter.Server (attach)",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
