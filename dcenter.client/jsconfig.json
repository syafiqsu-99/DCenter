{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@/*": [ "./src/*" ]
    }
  },
  "include": [ "src/**/*.js", "src/**/*.vue" ]
}
